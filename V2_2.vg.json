{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "Top 5 Malaysia States with Largest Area (km2)" },
"data": {
"url": "myArea.csv"
},
"mark": "point",
"selection": {
"state_highlight": {
"type": "multi",
"fields": ["State"],
"bind": "legend"
}},
"background": "transparent",
"encoding": {

"x": { "field": "Population", "type": "quantitative"},
"y": { "field": "Area", "type": "quantitative"},
"color": {"field": "State", "type": "nominal", "title": "State",
"scale":{
    "domain": ["Johor", "Sarawak","Sabah","Pahang","Perak" ],
    "range": ["#e41a1c", "#377eb8","#9c755f", "#ff9da7", "#66a61e"]
  }},
  "tooltip": [{"field":"State", "type": "nominal", "title":"State"},
{"field":"Area", "type": "quantitative", "title":"Area"},
{"field":"Population", "type": "quantitative", "title":"Population"}],
"opacity": {
"condition": {"selection": "state_highlight", "value": 1.0},
"value": 0.2
}
}
}