{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "Top 3 Malaysia States with Highest GDP (US$)" },
"data": {
"url": "myGDP.csv"
},
"mark": {"type":"line", "point": true},
"background": "transparent",
"selection": {
"state_highlight": {
"type": "multi",
"fields": ["State"],
"bind": "legend"
}
},
"encoding": {

"x": { "field": "Year", "type": "nominal"},
"y": { "field": "GDP", "type": "quantitative"},
"color": {"field": "State", "type": "nominal", "title": "State",
"scale":{
    "domain": ["Johor", "Sarawak","Kuala Lumpur and  Putrajaya","Selangor"],
    "range": ["#e41a1c", "#377eb8","#76b7b2", "#edc948"]
  }},
   "tooltip": [{"field":"State", "type": "nominal", "title":"State"},
{"field":"GDP", "type": "quantitative", "title":"GDP"},
{"field":"Year", "type": "nominal", "title":"Year"}],
"opacity": {
"condition": {"selection": "state_highlight", "value": 1.0},
"value": 0.2
}
}
}
