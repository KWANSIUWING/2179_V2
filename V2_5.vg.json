{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "The Ethnicity Compositioin of the Largest Malaysia City(KL)" },
"data": {
"url": "KL.csv"
},
"transform": [
  {
    "calculate": "datum.population / datum.total_population",
    "as": "proportion"
  }
],
"mark": {"type": "arc", "innerRadius": 40},"opacity": {
"condition": {"selection": "ethnicity_highlight", "value": 1.0},
"value": 0.2
},
"selection": {
"ethnicity_highlight": {
"type": "multi",
"fields": ["ethnicity"],
"bind": "legend"
}},
"background": "transparent",
"encoding": {
"theta": {"field": "proportion", "type": "quantitative"},
"color": {"field": "ethnicity", "type": "nominal","scale": {
    "domain": ["chinese", "bumi", "indian", "others"],
    "range": ["#F5A623", "#4A90E2", "#E74C8B", "#AAAAAA"]
  }},
"tooltip": [{"field":"city", "type": "nominal", "title":"city"},
{"field":"ethnicity", "type": "nominal", "title":"ethnicity"},
{"field":"proportion", "type": "quantitative", "title":"proportion","format":".1%"}]
,"opacity": {
"condition": {"selection": "ethnicity_highlight", "value": 1.0},
"value": 0.2
}}
}