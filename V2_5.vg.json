{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "The Ethnicity Compositioin of the Largest Malaysia City(KL)" },
"data": {
"url": "KL.csv"
},
"mark": "arc",
"selection": {
"ethnicity_highlight": {
"type": "multi",
"fields": ["ethnicity"],
"bind": "legend"
}},
"background": "transparent",
"encoding": {
"theta": {"field": "population", "type": "quantitative"},
"color": {"field": "ethnicity", "type": "nominal"},
"tooltip": [{"field":"city", "type": "nominal", "title":"city"},
{"field":"ethnicity", "type": "nominal", "title":"ethnicity"},
{"field":"population", "type": "quantitative", "title":"population"}],
"opacity": {
"condition": {"selection": "ethnicity_highlight", "value": 1.0},
"value": 0.2
}
}
}
