{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "Top 6 Malaysia Cities(Metropolitan Areas) with Largest Area" },
"data": {
"url": "myCity.csv"
},
"mark": "bar",
"background": "transparent",
"encoding": {

"x": { "field": "area_km2", "type": "quantitative"},
