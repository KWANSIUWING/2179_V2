"color": {"field": "city", "type": "nominal", "title": "city",
"scale":{
    "domain": ["Kuala Lumpur", "Ipoh",
     "Johor Bahru", "George Town", "Kuching", "Kota Kinabalu"],
    "range": ["#377eb8","#377eb8", "#ff7b00", "#377eb8", 
    "#377eb8", "#377eb8", "#377eb8"]
  }},

 "tooltip": [{"field":"city", "type": "nominal", "title":"city"},
{"field":"population", "type": "quantitative", "title":"population"}]
}
}