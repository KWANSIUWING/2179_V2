{
"$schema": "https://vega.github.io/schema/vega-lite/v5.json",
"title": { "text": "Malaysia States Birth across Year" },
"data": {
"url": "birth_state.csv"
},
"mark": "area",
"background": "transparent",
"selection": {
"state_highlight": {
"type": "multi",
"fields": ["state"],
"bind": "legend"
}
},
"encoding": {

"x": { "field": "date", "type": "ordinal"},
"y": { "field": "abs", "type": "quantitative", "title":"new brith"},
"color": {"field": "state", "type": "nominal", "title": "state","scale":{
    "domain": ["Johor", "Sarawak","Sabah","Pahang","Perak","Kedah",
    "Kelantan", "Melaka","Selangor", "Perlis","Pulau Pinang",
    "Negeri Sembilan", "Terengganu","W.P. Kuala Lumpur","W.P. Labuan",
    "W.P. Putrajaya"],
    "range": ["#e41a1c", "#377eb8","#9c755f", "#ff9da7", "#66a61e",
     "#984EA3","#FF7F00","#17BECF", "#edc948", "#F781BF","#999999",
     "#A65628","#B07AA1","#76B7B2","#FFFF33", "#EDC948"]
  }},

 "tooltip": [{"field":"state", "type": "nominal", "title":"state"},
{"field":"abs", "type": "quantitative", "title":"new brith"}],
"opacity": {
"condition": {"selection": "state_highlight", "value": 1.0},
"value": 0.2
}}
}